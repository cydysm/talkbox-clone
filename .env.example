DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-a-long-random-value
DEBUG=false
SECURE_SSL_REDIRECT=false
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_NAME=Talkbox
THEME=cactus_dark
# Docker Compose default:
# postgres://talkbox:replace-with-a-database-password@db:5432/talkbox
DATABASE_URL=postgres://talkbox:replace-with-a-database-password@db:5432/talkbox
POSTGRES_DB=talkbox
POSTGRES_USER=talkbox
POSTGRES_PASSWORD=replace-with-a-database-password
DATABASE_URL=postgres://talkbox:replace-with-a-database-password@db:5432/talkbox
REDIS_URL=redis://redis:6379/0
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com
HTTP_PORT=8000
