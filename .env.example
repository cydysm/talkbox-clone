DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-a-long-random-value
DEBUG=false
SECURE_SSL_REDIRECT=false
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_NAME=Talkbox
SITE_DESCRIPTION=Talkbox Clone - Python blog
FEED_LIMIT=20
THEME=cactus_dark
POSTS_PER_PAGE=10
# Docker Compose default:
# postgres://talkbox:replace-with-a-database-password@db:5432/talkbox
DATABASE_URL=postgres://talkbox:replace-with-a-database-password@db:5432/talkbox
POSTGRES_DB=talkbox
POSTGRES_USER=talkbox
POSTGRES_PASSWORD=replace-with-a-database-password
DATABASE_URL=postgres://talkbox:replace-with-a-database-password@db:5432/talkbox
REDIS_URL=redis://redis:6379/0
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com
NOTIFY_EMAIL=
COMMENT_REPLY_NOTIFY=true
COMMENT_INTERVAL_SECONDS=30
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
HTTP_PORT=8000
GUNICORN_WORKERS=2
GUNICORN_WORKER_CONNECTIONS=200
GUNICORN_MAX_REQUESTS=2000
GUNICORN_ACCESS_LOG=
CONN_MAX_AGE=60
WATERMARK_TEXT=
WATERMARK_IMAGE_PATH=
# 水印字体文件路径；留空时按内置候选列表探测，都没有则用 Pillow 默认字体
WATERMARK_FONT_PATH=
# 部署在可信反代之后且反代会覆盖 X-Forwarded-For 时设为 true（限流/记录用真实客户端 IP）
USE_X_FORWARDED_FOR=false
UPLOAD_MAX_MB=10
UPLOAD_MAX_IMAGES=20
UPLOAD_TOTAL_LIMIT_GB=20
IMAGE_MAX_DIMENSION=8000
THUMBNAIL_SIZE=240,240
