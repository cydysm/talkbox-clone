DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-a-long-random-value
DEBUG=false
SECURE_SSL_REDIRECT=false
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_NAME=Talkbox
SITE_DESCRIPTION=Talkbox Clone - Python blog
FEED_LIMIT=20
THEME=cactus_dark
POSTS_PER_PAGE=10
# Docker Compose default:
# postgres://talkbox:replace-with-a-database-password@db:5432/talkbox
DATABASE_URL=postgres://talkbox:replace-with-a-database-password@db:5432/talkbox
POSTGRES_DB=talkbox
POSTGRES_USER=talkbox
POSTGRES_PASSWORD=replace-with-a-database-password
DATABASE_URL=postgres://talkbox:replace-with-a-database-password@db:5432/talkbox
REDIS_URL=redis://redis:6379/0
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com
NOTIFY_EMAIL=
COMMENT_REPLY_NOTIFY=true
COMMENT_INTERVAL_SECONDS=30
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
HTTP_PORT=8000
WATERMARK_TEXT=
WATERMARK_IMAGE_PATH=
UPLOAD_MAX_MB=10
UPLOAD_MAX_IMAGES=20
IMAGE_MAX_DIMENSION=8000
